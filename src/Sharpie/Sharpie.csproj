<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <!-- contentFiles excluded: Spargine adds its icon (SPARGINE-ICON-GRAPHIC-SMALL.ico) to every project that references it. -->
    <PackageReference Include="DotNetTips.Spargine.10.Core" Version="2026.10.10.1" ExcludeAssets="contentFiles" />
    <PackageReference Include="Porta.Pty" Version="2.2.3" />
    <!-- Spargine Core pulls in System.Security.Cryptography.Xml 10.0.0, which has known high severity
         vulnerabilities (NU1903). Pinned to the patched version Spargine's own Tester package uses. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.12" />
  </ItemGroup>

  <!-- icon.png is rendered from icon.svg with: rsvg-convert -w 256 Assets/icon.svg -o Assets/icon.png -->
  <ItemGroup>
    <AvaloniaResource Include="Assets/icon.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sharpie.Tests" />
    <InternalsVisibleTo Include="Sharpie.Benchmarks" />
  </ItemGroup>

  <!-- Builds the shell and copies it next to the window app, which starts it as a child process. -->
  <ItemGroup>
    <ProjectReference Include="..\Sharpie.Shell\Sharpie.Shell.csproj" />
  </ItemGroup>

</Project>
